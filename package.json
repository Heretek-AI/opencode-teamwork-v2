{
  "name": "@heretek-ai/opencode-teamwork-v2",
  "version": "0.19.2",
  "description": "Antigravity-style multi-agent orchestration for OpenCode V2 — 15 agents, 7 commands, interactive model assignment on install.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "agents",
    "multi-agent",
    "orchestration",
    "teamwork",
    "deepseek"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heretek-AI/opencode-teamwork-v2.git"
  },
  "homepage": "https://github.com/Heretek-AI/opencode-teamwork-v2#readme",
  "bugs": {
    "url": "https://github.com/Heretek-AI/opencode-teamwork-v2/issues"
  },
  "type": "module",
  "exports": {
    ".": "./plugins/opencode-teamwork/index.ts"
  },
  "main": "./plugins/opencode-teamwork/index.ts",
  "bin": {
    "opencode-teamwork": "bin/opencode-teamwork.mjs",
    "opencode-teamwork-v2": "bin/opencode-teamwork.mjs"
  },
  "files": [
    "agents",
    "plugins",
    "lib",
    "bin",
    "docs",
    "!docs/re/**",
    "scripts",
    "postinstall.mjs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node ./postinstall.mjs",
    "lint:prompts": "node ./scripts/lint-prompts.mjs",
    "lint:security": "node ./scripts/lint-security-claims.mjs",
    "test:cost": "node ./scripts/test-cost.mjs",
    "test:engine": "node ./scripts/test-engine.mjs",
    "test:catalog": "node ./scripts/test-catalog.mjs",
    "test:tool-schema": "node ./scripts/test-tool-schema.mjs",
    "test:doctor": "node ./scripts/test-doctor.mjs",
    "test:timeline": "node ./scripts/test-timeline.mjs",
    "test:safe-fs": "node ./scripts/test-safe-fs.mjs",
    "test:safe-fs-write": "node ./scripts/test-safe-fs-write.mjs",
    "test:export": "node ./scripts/test-export.mjs",
    "test:auth": "node ./scripts/test-auth.mjs",
    "test:approval": "node ./scripts/test-approval.mjs",
    "test:verify": "node ./scripts/test-verify.mjs",
    "test:attest-input": "node ./scripts/test-check-attest-input.mjs",
    "test:security": "node ./scripts/test-security.mjs",
    "test": "npm run lint:prompts && npm run lint:security && npm run test:cost && npm run test:catalog && npm run test:tool-schema && npm run test:engine && npm run test:doctor && npm run test:timeline && npm run test:safe-fs && npm run test:safe-fs-write && npm run test:export && npm run test:auth && npm run test:approval && npm run test:verify && npm run test:attest-input && npm run test:security",
    "init": "node ./bin/opencode-teamwork.mjs init",
    "models": "node ./bin/opencode-teamwork.mjs models",
    "status": "node ./bin/opencode-teamwork.mjs status",
    "doctor": "node ./bin/opencode-teamwork.mjs doctor",
    "timeline": "node ./bin/opencode-teamwork.mjs timeline",
    "verify": "node ./bin/opencode-teamwork.mjs verify",
    "runs": "node ./bin/opencode-teamwork.mjs runs",
    "inspect": "node ./bin/opencode-teamwork.mjs inspect",
    "prune": "node ./bin/opencode-teamwork.mjs prune",
    "export": "node ./bin/opencode-teamwork.mjs export",
    "test:agy-parity": "node ./scripts/test-agy-parity.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.4"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
