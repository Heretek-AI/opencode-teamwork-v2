  ],
  "supportEntry": [
    "tests/runtime/harness/preload.ts",
    "tests/runtime/harness/race-child.ts",
    "scripts/test-agy-parity.mjs"
  ],
  "ignoreUnresolvedImports": ["/preload.js"],
