    },
    {
      "file": "plugins/opencode-teamwork/lemma.ts",
      "exports": ["LEMMA_ID"]
    },
    {
      "file": "plugins/opencode-teamwork/safe-fs.mjs",
      "exports": ["setRequirePinnedWritesForTest"]
    },
    {
      "file": "plugins/opencode-teamwork/tools.ts",
      "exports": ["nextEventSeqFromFd"]
    },
    {
      "file": "plugins/opencode-teamwork/url-guard.ts",
      "exports": ["ALLOW_LOCALHOST_ENV"]
    }
  ]
}
